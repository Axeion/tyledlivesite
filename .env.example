# ---- Platform ------------------------------------------------------------
# Apex domain the marketing site and /admin live on. Lodges get {slug}.PLATFORM_DOMAIN.
# In production: tyled.live. In local dev with Caddy: localhost (Chrome resolves *.localhost).
PLATFORM_DOMAIN=localhost
# Scheme used when building absolute URLs (https behind Caddy, http for bare `next dev`).
PLATFORM_SCHEME=https
# Port suffix to append to generated URLs in dev (leave empty in production / behind Caddy).
PLATFORM_PORT=
# Set to 1 when running behind Caddy/nginx so X-Forwarded-For is trusted for rate limiting.
TRUST_PROXY=1
# 32+ random bytes; used to sign/derive tokens. `openssl rand -hex 32`
APP_SECRET=change-me-to-a-long-random-string

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql://tyled:tyled@localhost:5432/tyled

# ---- Object storage (S3 compatible; MinIO in dev) ------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tyled-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Public base URL that browsers can fetch objects from (bucket must allow anonymous GET).
S3_PUBLIC_URL=http://localhost:9000/tyled-uploads
S3_FORCE_PATH_STYLE=1

# ---- Stripe (test mode) --------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_xxx
# Optional: point the Stripe SDK at a different API host (used for the local mock server).
# Example: http://localhost:4242
STRIPE_API_BASE=

# ---- Geocoding -----------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT="tyled.live/0.1 (admin@tyled.live)"

# ---- Custom domain verification -----------------------------------------
# Optional DNS resolver override (host:port) for the verification worker; blank = system resolver.
DNS_RESOLVER=
DOMAIN_VERIFY_INTERVAL_SECONDS=60

# ---- Seed ----------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@tyled.live
SEED_ADMIN_PASSWORD=admin-password-change-me
SEED_LODGE_PASSWORD=lodge-password-change-me
