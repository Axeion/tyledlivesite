# Production Caddyfile for Tyled.Live.
# Every hostname (apex, *.PLATFORM_DOMAIN, verified custom domains) is served by
# one catch-all site block. Certificates are obtained on demand; before issuing
# one, Caddy asks the app whether the hostname is allowed (verified domain with
# an active custom-domain entitlement, or a platform host).
{
	email {$ACME_EMAIL}
	# Caddy 2.10 removed the `interval`/`burst` rate limits; the ask endpoint is
	# the only gate, and it only approves hosts that already exist in the database.
	on_demand_tls {
		ask http://web:3000/api/internal/tls/ask
	}
}

# Uploaded images, served straight from MinIO (path-style, anonymous GET on the
# bucket). Reads only: writes go through the app with signed requests on the
# internal network. Matched before the catch-all block below.
files.{$PLATFORM_DOMAIN} {
	encode zstd gzip

	@readonly method GET HEAD
	handle @readonly {
		reverse_proxy minio:9000
	}
	handle {
		respond "Method not allowed" 405
	}
}

# Redirect the www. alias of the apex to the apex.
www.{$PLATFORM_DOMAIN} {
	redir https://{$PLATFORM_DOMAIN}{uri} permanent
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# Internal endpoints (the on-demand TLS "ask" check) are only for Caddy itself.
	@internal path /api/internal/*
	respond @internal 404

	reverse_proxy web:3000 {
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}

# Plain HTTP: ACME HTTP-01 challenges are handled automatically; everything else upgrades.
http:// {
	redir https://{host}{uri} permanent
}
